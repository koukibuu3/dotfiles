# このファイルを .env.local にコピーして値を埋める（.env.local は .gitignore 対象）
#   cp .env.local.example .env.local
#
# 値は 1Password などから手動で持ってくること。ここに実値を書かないこと。

# MCP サーバー実装の置き場所（anyinc/dev-mcp-servers を clone + build したパス）
DEV_MCP_SERVERS_DIR="$HOME/Repos/anyinc/dev-mcp-servers"

# qast-knowledge-mcp
QAST_LOGIN_ID=""
QAST_LOGIN_PASSWORD=""
QAST_APP_KEY=""

# mysql-research-mcp（ローカル開発 DB）
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="qast_db"
DB_PASSWORD=""
DB_NAME="_data_design"

# obsidian-mcp-tools
OBSIDIAN_VAULT_DIR="$HOME/Notes"
OBSIDIAN_API_KEY=""
